		"browser-sync": "^2.27.10",
		"caniuse-lite": "^1.0.30001359",
		"css-declaration-sorter": "6.3.1",
		"cssnano": "5.1.12",
		"del": "6.0.0",
		"graceful-fs": "4.1.15",
